generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id          String   @id @default(uuid())
  title       String
  description String?
  themeColor  String?  @default("#7c3aed")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  columns     Column[]
  tags        Tag[]
}

model Column {
  id        String   @id @default(uuid())
  title     String
  position  Int
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model Card {
  id          String   @id @default(uuid())
  title       String
  description String?
  position    Int
  priority    String   @default("Medium")
  dueDate     DateTime?
  columnId    String
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  tags        Tag[]    @relation("CardTags")
  checklists  ChecklistItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([columnId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#7c3aed")
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]   @relation("CardTags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model ChecklistItem {
  id        String   @id @default(uuid())
  text      String
  completed Boolean  @default(false)
  position  Int
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}
