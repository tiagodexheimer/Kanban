generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(uuid())
  name           String?
  email          String?    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  accounts       Account[]
  activities     Activity[]
  ownedBoards    Board[]    @relation("BoardOwner")
  comments       Comment[]
  ownedProjects  Project[]  @relation("ProjectOwner")
  sessions       Session[]
  memberBoards   BoardPermission[]
  assignedCards  Card[]            @relation("CardAssignees")
  memberProjects ProjectMember[]
  docs           Doc[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boards      Board[]
  folders     Folder[]
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  docs        Doc[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Board {
  id           String        @id @default(uuid())
  title        String
  description  String?
  themeColor   String?       @default("#7c3aed")
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  projectId    String?
  folderId     String?
  activities   Activity[]
  folder       Folder?       @relation(fields: [folderId], references: [id])
  owner        User          @relation("BoardOwner", fields: [ownerId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns      Column[]
  customFields CustomField[]
  tags         Tag[]
  permissions  BoardPermission[]
  docs         Doc[]
}

model BoardPermission {
  id            String   @id @default(uuid())
  boardId       String
  userId        String
  canView       Boolean  @default(true)
  canEditTasks  Boolean  @default(true)
  canMoveTasks  Boolean  @default(true)
  canManageBoard Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  board         Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model Folder {
  id        String   @id @default(uuid())
  title     String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  boards    Board[]
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CustomField {
  id        String             @id @default(uuid())
  name      String
  type      String
  options   String?
  boardId   String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  board     Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  value         String?
  cardId        String
  customFieldId String
  card          Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([cardId, customFieldId])
}

model Column {
  id        String   @id @default(uuid())
  title     String
  position  Int
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  color     String?
  type      String   @default("IN_PROGRESS")
  cards     Card[]
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model Card {
  id                       String             @id @default(uuid())
  title                    String
  description              String?
  position                 Int
  priority                 String             @default("Medium")
  dueDate                  DateTime?
  columnId                 String
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  parentId                 String?
  activities               Activity[]
  column                   Column             @relation(fields: [columnId], references: [id], onDelete: Cascade)
  parent                   Card?              @relation("Subtasks", fields: [parentId], references: [id])
  subtasks                 Card[]             @relation("Subtasks")
  checklists               ChecklistItem[]
  comments                 Comment[]
  customFieldValues        CustomFieldValue[]
  assignees                User[]             @relation("CardAssignees")
  blockedBy                Card[]             @relation("CardDependencies")
  blocking                 Card[]             @relation("CardDependencies")
  relatedTo                Card[]             @relation("CardRelationships")
  relatesTo                Card[]             @relation("CardRelationships")
  tags                     Tag[]              @relation("CardTags")

  @@index([columnId])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  userId    String
  cardId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId])
}

model Activity {
  id          String   @id @default(uuid())
  type        String
  description String
  userId      String
  boardId     String
  cardId      String?
  createdAt   DateTime @default(now())
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card        Card?    @relation(fields: [cardId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([cardId])
}

model Tag {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#7c3aed")
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]   @relation("CardTags")

  @@index([boardId])
}

model ChecklistItem {
  id        String   @id @default(uuid())
  text      String
  completed Boolean  @default(false)
  position  Int
  cardId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

model Doc {
  id        String   @id @default(uuid())
  title     String
  content   String?  @db.Text
  parentId  String?
  boardId   String?
  projectId String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  parent    Doc?     @relation("SubDocs", fields: [parentId], references: [id])
  subDocs   Doc[]    @relation("SubDocs")
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id])

  @@index([boardId])
  @@index([projectId])
  @@index([ownerId])
}
